<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true"
        app:controller_layout_id="@layout/custom_player_controls"
        app:use_artwork="false"
        app:shutter_background_color="#000000"
        app:show_buffering="when_playing" />

    <!-- Buffer indicator -->
    <ProgressBar
        android:id="@+id/pb_buffer"
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_40sdp"
        android:layout_centerInParent="true"
        android:indeterminateTint="@color/app_color_4"
        android:visibility="gone" />

    <!-- Error overlay -->
    <RelativeLayout
        android:id="@+id/rlay_error"
        android:gravity="center"
        android:background="@color/trn_black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_error"
            android:textSize="@dimen/font_18"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true" />
    </RelativeLayout>

</RelativeLayout>
