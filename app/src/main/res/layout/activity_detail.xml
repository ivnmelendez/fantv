<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/background_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:focusable="false"
        android:clickable="false" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_detail_overlay" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/main_menu_view_width_closed">

        <!-- Left content panel -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/margin_10"
            android:paddingEnd="@dimen/margin_8"
            android:paddingTop="@dimen/margin_10"
            android:paddingBottom="@dimen/margin_10">

            <TextView
                android:id="@+id/tv_datetime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/font_12"
                android:textColor="#AAFFFFFF"
                android:layout_marginBottom="@dimen/margin_6"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/font_detail_title"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:maxLines="2"
                android:shadowColor="@color/black"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:layout_marginBottom="@dimen/margin_6" />

            <!-- IMDb badge + rating + year + duration -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/margin_8">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:src="@drawable/imdb_logo"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:layout_marginEnd="@dimen/margin_6" />

                <TextView
                    android:id="@+id/tv_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/font_14"
                    android:textColor="@color/white"
                    android:layout_marginEnd="@dimen/margin_10" />

                <TextView
                    android:id="@+id/tv_year"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/font_14"
                    android:textColor="@color/white"
                    android:layout_marginEnd="@dimen/margin_10" />

                <TextView
                    android:id="@+id/tv_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/font_14"
                    android:textColor="@color/white" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/font_14"
                android:textColor="#CCFFFFFF"
                android:maxLines="5"
                android:layout_marginBottom="@dimen/margin_6" />

            <LinearLayout
                android:id="@+id/lin_actors"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_3"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_cast"
                    android:textSize="@dimen/font_14"
                    android:textColor="#AAFFFFFF"
                    android:layout_marginEnd="@dimen/margin_3" />

                <TextView
                    android:id="@+id/tv_actors"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/font_14"
                    android:textColor="#CCFFFFFF"
                    android:maxLines="1" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/lin_genre"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_10"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_genre"
                    android:textSize="@dimen/font_14"
                    android:textColor="#AAFFFFFF"
                    android:layout_marginEnd="@dimen/margin_3" />

                <TextView
                    android:id="@+id/tv_genre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/font_14"
                    android:textColor="#CCFFFFFF" />

            </LinearLayout>

            <!-- Primary play button (outlined) -->
            <TextView
                android:id="@+id/btn_play_primary"
                android:layout_width="@dimen/detail_btn_width"
                android:layout_height="@dimen/detail_btn_height"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/margin_10"
                android:paddingEnd="@dimen/margin_10"
                android:text="@string/detail_play_primary"
                android:textSize="@dimen/font_14"
                android:textColor="@color/white"
                android:background="@drawable/selector_detail_btn_primary"
                android:focusable="true"
                android:clickable="true"
                android:layout_marginBottom="@dimen/margin_4" />

            <!-- Secondary play button (hidden unless alternate stream exists) -->
            <TextView
                android:id="@+id/btn_play_secondary"
                android:layout_width="@dimen/detail_btn_width"
                android:layout_height="@dimen/detail_btn_height"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/margin_10"
                android:paddingEnd="@dimen/margin_10"
                android:text="@string/detail_play_secondary"
                android:textSize="@dimen/font_14"
                android:textColor="@color/white"
                android:background="@drawable/selector_detail_btn_secondary"
                android:focusable="true"
                android:clickable="true"
                android:visibility="gone"
                android:layout_marginBottom="@dimen/margin_4" />

            <TextView
                android:id="@+id/btn_favorites"
                android:layout_width="@dimen/detail_btn_width"
                android:layout_height="@dimen/detail_btn_height"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/margin_10"
                android:paddingEnd="@dimen/margin_10"
                android:text="@string/detail_favorite"
                android:textSize="@dimen/font_14"
                android:textColor="@color/white"
                android:background="@drawable/selector_detail_btn_secondary"
                android:focusable="true"
                android:clickable="true"
                android:layout_marginBottom="@dimen/margin_4" />

            <TextView
                android:id="@+id/btn_remove_history"
                android:layout_width="@dimen/detail_btn_width"
                android:layout_height="@dimen/detail_btn_height"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/margin_10"
                android:paddingEnd="@dimen/margin_10"
                android:text="@string/detail_remove_history"
                android:textSize="@dimen/font_14"
                android:textColor="#FFAAAAAA"
                android:background="@drawable/selector_detail_btn_secondary"
                android:focusable="true"
                android:clickable="true"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Right spacer: transparent, backdrop character shows through -->
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

    </LinearLayout>

    <include
        android:id="@+id/loadingLayout"
        layout="@layout/layout_loading"
        android:visibility="gone" />

</RelativeLayout>
