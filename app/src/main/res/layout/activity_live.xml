<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Full-screen video -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        android:clickable="false" />

    <!-- No signal overlay -->
    <FrameLayout
        android:id="@+id/rlay_offline"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_offline_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/channel_offline"
            android:textColor="@color/white"
            android:textSize="@dimen/font_title_feat"
            android:textStyle="bold" />

    </FrameLayout>

    <!-- Channel browser overlay (bottom) -->
    <LinearLayout
        android:id="@+id/overlay_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#E8000000"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Now playing bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/live_channel_height"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/main_menu_view_width_closed"
            android:paddingEnd="@dimen/margin_10"
            android:paddingTop="@dimen/margin_4"
            android:paddingBottom="@dimen/margin_4">

            <ImageView
                android:id="@+id/iv_current_logo"
                android:layout_width="@dimen/_32sdp"
                android:layout_height="@dimen/_22sdp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:layout_marginEnd="@dimen/margin_8" />

            <TextView
                android:id="@+id/tv_current_channel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/white"
                android:textSize="@dimen/font_sub_title"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#AAFFFFFF"
                android:textSize="@dimen/font_14" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:background="#33FFFFFF" />

        <!-- Category + Channel browser -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/live_categories_height"
            android:paddingStart="@dimen/main_menu_view_width_closed"
            android:orientation="horizontal">

            <!-- Category list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/category_grid"
                android:layout_width="@dimen/live_categories_width"
                android:layout_height="match_parent"
                android:focusable="true"
                android:descendantFocusability="afterDescendants" />

            <!-- Divider -->
            <View
                android:layout_width="1px"
                android:layout_height="match_parent"
                android:background="#33FFFFFF" />

            <!-- Channel list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/channel_grid"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:focusable="true"
                android:descendantFocusability="afterDescendants" />

        </LinearLayout>

    </LinearLayout>

    <!-- Loading overlay -->
    <include
        android:id="@+id/loadingLayout"
        layout="@layout/layout_loading"
        android:visibility="gone" />

</FrameLayout>
