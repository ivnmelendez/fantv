<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Gradient background: brand colors -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#E40717"
                android:endColor="#FA3803" />
        </shape>
    </item>

    <!-- FanTV logo centered with safe-zone padding -->
    <item
        android:drawable="@drawable/fantv_logo"
        android:gravity="center"
        android:top="18dp"
        android:bottom="18dp"
        android:left="18dp"
        android:right="18dp" />

</layer-list>
